# =====================================================
# RankZee Digital Marketing Agency Environment Variables
# =====================================================

# Next.js App Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Client Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=rankzee-marketing.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=rankzee-marketing
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=rankzee-marketing.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin SDK Configuration (Server-side ONLY)
# Never expose these on the client side!
FIREBASE_PROJECT_ID=rankzee-marketing
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@rankzee-marketing.iam.gserviceaccount.com
# For FIREBASE_PRIVATE_KEY, keep \n escaped if stored as a single line, or base64 encode
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Analytics & Verification
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_search_console_token
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id

# Payment Gateway Keys (Placeholder Readiness)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholderKey123
RAZORPAY_KEY_SECRET=rzp_secret_placeholderSecret456
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_789

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholderKey123
STRIPE_SECRET_KEY=sk_test_placeholderSecret456
STRIPE_WEBHOOK_SECRET=whsec_placeholderSecret789

# Contact details fallback
NEXT_PUBLIC_COMPANY_NAME="RankZee Digital Marketing Agency"
NEXT_PUBLIC_COMPANY_EMAIL="contact@rankzee.com"
NEXT_PUBLIC_COMPANY_PHONE="+91 98765 43210"
NEXT_PUBLIC_COMPANY_WHATSAPP="+919876543210"
NEXT_PUBLIC_COMPANY_ADDRESS="Cyber City Tech Park, Tower B, Sector 44, Gurugram, Haryana 122003, India"

